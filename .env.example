# ── LLM 配置（硅基流动 SiliconFlow，9B 以下永久免费）──
# 获取免费 API Key: https://cloud.siliconflow.cn/
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=THUDM/GLM-4-9B-0414

# ── GitHub Token（提高 API 配额）──
# 无 Token：每小时 10 次搜索
# 有 Token：每小时 30 次搜索 + 5000 次普通请求
GITHUB_TOKEN=ghp-your-github-token-here

# ── TTS 配置 ──
# 引擎：auto（自动回退 siliconflow→edge-tts→espeak-ng）、siliconflow、edge-tts、espeak-ng
TTS_ENGINE=auto
# 语速：如 +10%% 加速，-10%% 减速（默认 +0%%）
TTS_RATE=+0%

# ── TTS 高级配置（可选，默认使用硅基流动）──
# TTS_API_KEY：仅在 LLM 提供商非硅基流动时需要单独设置
# 如果 LLM 用 DeepSeek/OpenAI 等，TTS 会自动降级到免费的 edge-tts
# 如需使用硅基流动 TTS，请单独设置此 Key
# TTS_API_KEY=sk-your-siliconflow-key
# TTS_BASE_URL=https://api.siliconflow.cn/v1
# TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# TTS_VOICE_ZH=FunAudioLLM/CosyVoice2-0.5B:alex
# TTS_VOICE_EN=FunAudioLLM/CosyVoice2-0.5B:alex
